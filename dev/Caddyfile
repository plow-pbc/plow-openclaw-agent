# LOCAL DEV ONLY: anyone who can reach the published loopback port is admin.
:3001 {
	@foreign_origin {
		header Origin *
		not {
			header Origin http://localhost:{$PLOW_DEV_PORT:3001}
			header Origin http://127.0.0.1:{$PLOW_DEV_PORT:3001}
		}
	}
	respond @foreign_origin 403

	request_header -X-Plow-*
	request_header -X-Forwarded-*
	request_header -Forwarded
	request_header -X-Real-IP

	reverse_proxy 127.0.0.1:3000 {
		header_up Host 127.0.0.1:3000
		# The original origin passed the allowlist above; match the upstream Host.
		header_up Origin http://127.0.0.1:3000
		header_up X-Plow-User dev-owner
	}
}
